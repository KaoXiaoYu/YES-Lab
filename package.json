  "private": true,
  "description": "YES Lab 实验室展示、成员协作与管理平台",
  "type": "module",
  "packageManager": "npm@10.9.7",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
