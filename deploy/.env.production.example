# 域名只填写主机名，不包含 https://；上线前需将域名解析到服务器。
YESLAB_SITE_ADDRESS=lab.example.edu.cn
YESLAB_CORS_ALLOWED_ORIGINS=https://lab.example.edu.cn

# GitHub Actions 会同时发布 latest 与提交 SHA 标签；正式发布建议填写完整 SHA。
YESLAB_IMAGE_TAG=latest
YESLAB_API_IMAGE=ghcr.io/kaoxiaoyu/yes-lab-api
YESLAB_WEB_IMAGE=ghcr.io/kaoxiaoyu/yes-lab-web

# 业务数据必须位于 Git 仓库之外。
YESLAB_DATA_ROOT=/srv/yeslab/data
YESLAB_DATABASE_USERNAME=yeslab
YESLAB_DATABASE_PASSWORD=replace-with-a-random-database-password
YESLAB_MYSQL_ROOT_PASSWORD=replace-with-a-different-random-root-password

# 建议执行 `openssl rand -hex 64` 生成；发布后不可随意更换，否则现有访问 JWT 会失效。
YESLAB_JWT_SECRET=replace-with-at-least-32-random-bytes
YESLAB_JWT_ISSUER=yes-lab-api

# 40 GB 服务器建议本机只保留 7 天，并将备份同步到异地存储。
YESLAB_BACKUP_ROOT=/srv/yeslab/backups
YESLAB_BACKUP_RETENTION_DAYS=7
