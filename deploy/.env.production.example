# 域名只填写主机名，不包含 https://；上线前需将域名解析到服务器。
OPENLIMS_SITE_ADDRESS=lab.example.edu.cn
OPENLIMS_CORS_ALLOWED_ORIGINS=https://lab.example.edu.cn

# GitHub Actions 会同时发布 latest 与提交 SHA 标签；正式发布建议填写完整 SHA。
OPENLIMS_IMAGE_TAG=latest
OPENLIMS_API_IMAGE=ghcr.io/yeslab-uavtech/openlims-api
OPENLIMS_WEB_IMAGE=ghcr.io/yeslab-uavtech/openlims-web

# 业务数据必须位于 Git 仓库之外。
OPENLIMS_DATA_ROOT=/srv/openlims/data
OPENLIMS_DATABASE_USERNAME=openlims
OPENLIMS_DATABASE_PASSWORD=replace-with-a-random-database-password
OPENLIMS_MYSQL_ROOT_PASSWORD=replace-with-a-different-random-root-password

# 建议执行 `openssl rand -hex 64` 生成；发布后不可随意更换，否则现有访问 JWT 会失效。
OPENLIMS_JWT_SECRET=replace-with-at-least-32-random-bytes
OPENLIMS_JWT_ISSUER=openlims-api

# 40 GB 服务器建议本机只保留 7 天，并将备份同步到异地存储。
OPENLIMS_BACKUP_ROOT=/srv/openlims/backups
OPENLIMS_BACKUP_RETENTION_DAYS=7
