{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "YES Lab: 启动后端",
      "type": "shell",
      "command": "task_java_home=$(/usr/libexec/java_home -v 21) && export JAVA_HOME=\"$task_java_home\" && export PATH=\"$JAVA_HOME/bin:$PATH\" && ./mvnw spring-boot:run",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "yes-lab-backend",
        "clear": true
      }
    },
    {
      "label": "YES Lab: 启动前端",
      "type": "shell",
      "command": "VITE_API_BASE_URL=http://127.0.0.1:8080 npm run dev -- --host 127.0.0.1",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "yes-lab-frontend",
        "clear": true
      }
    },
    {
      "label": "YES Lab: 一键启动本地开发",
      "dependsOn": [
        "YES Lab: 启动后端",
        "YES Lab: 启动前端"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
