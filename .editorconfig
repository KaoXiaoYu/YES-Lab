root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{js,json,json5,mjs,cjs,vue,css,scss,html,yml,yaml}]
indent_style = space
indent_size = 2

[*.{java,xml}]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{sh,bash}]
indent_style = space
indent_size = 2

